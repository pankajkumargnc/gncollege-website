# ═══════════════════════════════════════════════════════════════════
#  GNC Digital Campus — Website 2.0 Environment Configuration
#  Copy this template to ".env" for local development.
#  NEVER commit real .env files with production secrets to Git!
# ═══════════════════════════════════════════════════════════════════

# ── Firebase Project Configuration ───────────────────────────────
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=gnc-college-web.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=gnc-college-web
VITE_FIREBASE_STORAGE_BUCKET=gnc-college-web.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# ── Canonical Domain & Host Configuration (Sections 37 & 90) ──────
# Default canonical domain for SEO, sitemap, OpenGraph, JSON-LD
VITE_CANONICAL_DOMAIN=https://gncollege.org

# ── AI & Academic Assistant Services (Section 58) ────────────────
# Gemini API Key (Optional client key; server proxy preferred)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# ── Security & Bot Protection (reCAPTCHA v3 / App Check) ─────────
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_v3_site_key

# ── Google Drive Sync Integration (Optional) ─────────────────────
VITE_DRIVE_API_KEY=your_google_drive_api_key
VITE_DRIVE_REGULATIONS_FOLDER=your_regulations_folder_id

# ── Error Monitoring (Optional Sentry DSN) ────────────────────────
VITE_SENTRY_DSN=your_sentry_dsn_here
