# ══════════════════════════════════════════════════════════
#  GNC College Website — Firebase Environment Variables
#  
#  STEPS:
#  1. Is file ko copy karke naam ".env" rakh do (root folder mein)
#  2. Apni Firebase Console se values fill karo
#  3. Firebase Console → Project Settings → Your Apps → Config
#  4. .env file kabhi bhi GitHub pe push mat karo!
# ══════════════════════════════════════════════════════════

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# ── Admin Login Credentials ──────────────────────────────────────────
# (optional — default: admin / admin123 — zaroor change karo!)
VITE_ADMIN_USERNAME=admin
VITE_ADMIN_PASSWORD=admin123

# ── AI & Security Services ──────────────────────────────────────────
# Gemini AI Academic Assistant API Key (Build-time / Environment only)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Firebase App Check (reCAPTCHA v3 Site Key for Bot / Scraper Protection)
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_v3_site_key

# Sentry Error Monitoring DSN (optional)
VITE_SENTRY_DSN=your_sentry_dsn_here

