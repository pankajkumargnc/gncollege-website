rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() { return request.auth != null; }
    function isAdmin() {
      return isAuth() && (
        request.auth.token.email in ["pankajkumargnc@gmail.com", "admin@gncollege.org", "principal@gncollege.org"] ||
        request.auth.token.admin == true
      );
    }

    match /notices/{docId}          { allow read: if true; allow write: if isAdmin(); }
    match /announcements/{docId}    { allow read: if true; allow write: if isAdmin(); }
    match /events/{docId}           { allow read: if true; allow write: if isAdmin(); }
    match /gallery/{docId}          { allow read: if true; allow write: if isAdmin(); }
    match /faculties/{docId}        { allow read: if true; allow write: if isAdmin(); }
    match /sliderSlides/{docId}     { allow read: if true; allow write: if isAdmin(); }
    match /updates/{docId}          { allow read: if true; allow write: if isAdmin(); }
    match /pages/{docId}            { allow read: if true; allow write: if isAdmin(); }
    match /alerts/{docId}           { allow read: if true; allow write: if isAdmin(); }
    match /placements/{docId}       { allow read: if true; allow write: if isAdmin(); }
    match /pdfReports/{docId}       { allow read: if true; allow write: if isAdmin(); }
    match /reports/{docId}          { allow read: if true; allow write: if isAdmin(); }
    match /testimonials/{docId}     { allow read: if true; allow write: if isAdmin(); }
    match /contactDirectory/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /navigation/{docId}       { allow read: if true; allow write: if isAdmin(); }
    match /leadership/{docId}       { allow read: if true; allow write: if isAdmin(); }
    match /departments/{docId}      { allow read: if true; allow write: if isAdmin(); }
    match /campus_gallery/{docId}   { allow read: if true; allow write: if isAdmin(); }
    match /gb_meetings/{docId}      { allow read: if true; allow write: if isAdmin(); }
    match /staff_council/{docId}    { allow read: if true; allow write: if isAdmin(); }
    match /pageContent/{docId}      { allow read: if true; allow write: if isAdmin(); }
    match /push_broadcasts/{docId}  { allow read, write: if isAdmin(); }
    match /document_requests/{docId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if request.resource.data.keys().hasAll(['studentName', 'docTitle', 'trackingToken', 'createdAt']);
      allow update, delete: if isAdmin();
    }
    match /polls/{docId} { 
      allow read: if true; 
      allow update: if (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['options', 'totalVotes', 'votedIps', 'hasVoted']) &&
        request.resource.data.question == resource.data.question &&
        request.resource.data.options.size() == resource.data.options.size()
      ) || isAdmin(); 
      allow create, delete: if isAdmin(); 
    }
    match /site_visits/{docId} { 
      allow read: if isAdmin(); 
      allow create: if request.resource.data.keys().hasAny(['timestamp', 'page', 'device', 'referrer', 'date']); 
      allow update, delete: if isAdmin(); 
    }
    match /site_traffic/{docId} { 
      allow read: if isAdmin(); 
      allow create, update: if request.resource.data.keys().hasAny(['count', 'views', 'updatedAt', 'date', 'page']) || isAdmin(); 
      allow delete: if isAdmin(); 
    }
    match /counters/{docId} { 
      allow read: if true; 
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasAny(['count', 'value', 'updatedAt']) || isAdmin(); 
      allow create, delete: if isAdmin(); 
    }
    // Settings: public metadata (site, site_sync, chatbot) readable by all.
    // SECURITY: sensitive keys (geminiApiKey) must NOT be stored in public-readable docs.
    // Use environment variables for API keys instead (see firebase.js / AIChatbot.jsx).
    match /settings/site             { allow read: if true; allow write: if isAdmin(); }
    match /settings/site_sync        { allow read: if true; allow write: if isAdmin(); }
    match /settings/chatbot          { allow read: if true; allow write: if isAdmin(); }
    match /settings/contact          { allow read: if true; allow write: if isAdmin(); }
    match /settings/{otherSettingId} { allow read: if isAdmin(); allow write: if isAdmin(); }
    match /adminLogs/{docId}        { allow read, write, create: if isAdmin(); }
    match /_sysTest/{docId}         { allow read, write, delete: if isAdmin(); }
    match /_systemTest/{docId}      { allow read, write, delete: if isAdmin(); }
    match /_securityProbe/{docId}   { allow read, write, delete: if isAdmin(); }
    match /{document=**}            { allow read, write: if false; }
  }
}
